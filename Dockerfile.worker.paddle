# syntax=docker/dockerfile:1.7

# Build Cython-protected runtime sources using the same runtime family as the
# final worker image, so compiled extensions match the Python ABI.
FROM paddlepaddle/paddle:2.6.2-gpu-cuda11.7-cudnn8.4-trt8.4 AS source-protector

ENV PYTHONUNBUFFERED=1

WORKDIR /build

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends build-essential; \
    rm -rf /var/lib/apt/lists/*

COPY requirements/build.txt ./requirements/build.txt
RUN pip install --no-cache-dir -r requirements/build.txt
COPY setup.py ./setup.py
COPY train_platform/ ./train_platform/

RUN python -m train_platform.core.build_protected_runtime --output /protected-runtime

# PaddleDetection training worker image.
FROM paddlepaddle/paddle:2.6.2-gpu-cuda11.7-cudnn8.4-trt8.4

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV PYTHONUTF8=1
ENV TRAIN_PLATFORM_LICENSE_REQUIRED=1
ENV TRAIN_PLATFORM_LICENSE_PATH=/app/license/license.dat

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 default-mysql-client git; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements/ ./requirements/
RUN pip install --no-cache-dir -r requirements/worker.paddle.txt

RUN pip install --no-cache-dir \
    "numpy==1.23.5" \
    "protobuf<=3.20.3" \
    pycocotools \
    typeguard \
    "visualdl>=2.2.0" \
    lap \
    tqdm \
    motmetrics \
    pyclipper \
    shapely \
    terminaltables \
    Cython

# Clone PaddleDetection repo. The platform imports ppdet and official configs
# from this checkout instead of the incomplete paddledet wheel.
RUN git clone --branch release/2.6 --depth 1 https://github.com/PaddlePaddle/PaddleDetection.git /app/PaddleDetection \
    && rm -rf /app/PaddleDetection/.git /app/PaddleDetection/deploy /app/PaddleDetection/docs \
              /app/PaddleDetection/test /app/PaddleDetection/benchmark /app/PaddleDetection/demo_input
ENV PADDLE_DET_DIR=/app/PaddleDetection
ENV PYTHONPATH=/app/PaddleDetection:${PYTHONPATH}

RUN python - <<'PY'
import paddle
print("paddle:", paddle.__version__)
from ppdet.core.workspace import load_config
load_config("/app/PaddleDetection/configs/ppyoloe/ppyoloe_plus_crn_s_80e_coco.yml")
print("ppdet source checkout: OK")
PY

COPY --from=source-protector /protected-runtime/ ./
COPY alembic.ini .

RUN mkdir -p /app/datasets /app/datasets/.uploads /app/datasets/.staging /app/imports /app/training_runs /app/temp
RUN --mount=type=secret,id=train_platform_license,required=false \
    mkdir -p /app/license && \
    if [ -f /run/secrets/train_platform_license ]; then \
        cp /run/secrets/train_platform_license /app/license/license.dat; \
    fi

COPY docker/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "-m", "train_platform.workers.paddle_worker"]
