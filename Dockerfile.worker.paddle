# syntax=docker/dockerfile:1.7

# Build native-protected runtime sources using the same runtime family as the
# final worker image, so native extensions match its Python and glibc ABI.
FROM paddlepaddle/paddle:2.6.2-gpu-cuda11.7-cudnn8.4-trt8.4 AS source-protector

ENV PYTHONUNBUFFERED=1
ENV PATH=/root/.cargo/bin:${PATH}

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
       | sh -s -- -y --profile minimal --default-toolchain 1.85.1

COPY requirements/build.txt ./requirements/build.txt
RUN pip install --no-cache-dir -r requirements/build.txt

COPY setup.py ./setup.py
COPY train_platform/ ./train_platform/
COPY native/license_verifier/ ./native/license_verifier/

RUN CYTHON_INCLUDE_GLOBS="train_platform/services/*.py,train_platform/services/**/*.py,train_platform/workers/worker_impl.py,train_platform/workers/yolo_worker_impl.py,train_platform/workers/paddle_worker_impl.py,train_platform/workers/model_conversion_queue.py,train_platform/workers/model_conversion_task.py,train_platform/workers/inference_job_task.py,train_platform/workers/training/train_entry_impl.py,train_platform/workers/training/vdl_bridge.py" \
    python setup.py build_ext \
    && mkdir -p /protected-runtime \
    && cp -a build/runtime/. /protected-runtime/ \
    && python native/license_verifier/build.py --output /protected-runtime --enforce

# PaddleDetection training worker image.
FROM paddlepaddle/paddle:2.6.2-gpu-cuda11.7-cudnn8.4-trt8.4

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV PYTHONUTF8=1
ENV TRAIN_PLATFORM_LICENSE_REQUIRED=1
ENV TRAIN_PLATFORM_LICENSE_PATH=/app/license/license.dat

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 default-mysql-client git; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements/ ./requirements/
RUN pip install --no-cache-dir -r requirements/worker.paddle.txt

RUN pip install --no-cache-dir \
    "numpy==1.23.5" \
    "protobuf<=3.20.3" \
    pycocotools \
    typeguard \
    "visualdl>=2.2.0" \
    lap \
    tqdm \
    motmetrics \
    pyclipper \
    shapely \
    terminaltables

# Clone PaddleDetection repo. The platform imports ppdet and official configs
# from this checkout instead of the incomplete paddledet wheel.
RUN git clone --branch release/2.6 --depth 1 https://github.com/PaddlePaddle/PaddleDetection.git /app/PaddleDetection \
    && rm -rf /app/PaddleDetection/.git /app/PaddleDetection/deploy /app/PaddleDetection/docs \
              /app/PaddleDetection/test /app/PaddleDetection/benchmark /app/PaddleDetection/demo_input
ENV PADDLE_DET_DIR=/app/PaddleDetection
ENV PYTHONPATH=/app/PaddleDetection:${PYTHONPATH}

RUN python - <<'PY'
import paddle
print("paddle:", paddle.__version__)
from ppdet.core.workspace import load_config
load_config("/app/PaddleDetection/configs/ppyoloe/ppyoloe_plus_crn_s_80e_coco.yml")
print("ppdet source checkout: OK")
PY

# The upstream runtime image includes a full GCC toolchain. It is not needed
# after the Paddle/PPDet runtime self-check and must not ship in release images.
RUN rm -rf /usr/local/gcc-8.2 \
    && rm -f /usr/bin/cc /usr/bin/c++ /etc/alternatives/cc /etc/alternatives/c++

COPY --from=source-protector /protected-runtime/ ./
COPY alembic.ini .

RUN mkdir -p /app/datasets /app/datasets/.uploads /app/datasets/.staging /app/imports /app/training_runs /app/temp
RUN --mount=type=secret,id=train_platform_license,required=false \
    mkdir -p /app/license && \
    if [ -f /run/secrets/train_platform_license ]; then \
        cp /run/secrets/train_platform_license /app/license/license.dat; \
    fi

COPY docker/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "-m", "train_platform.workers.paddle_worker"]
