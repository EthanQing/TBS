MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_HOST=localhost
MYSQL_DATABASE=train_backend_v2
MYSQL_PORT=3306

# Optional (overrides MYSQL_*):
# DATABASE_URL=sqlite+pysqlite:///./train_backend_v2.db
# ALEMBIC_DATABASE_URL=sqlite+pysqlite:///./train_backend_v2.db

BACKEND_PORT=18000

# License enforcement (production/portable packages enable this)
# TRAIN_PLATFORM_LICENSE_REQUIRED=1
# TRAIN_PLATFORM_LICENSE_PATH=/app/license/license.dat
# TRAIN_PLATFORM_LICENSE_DATA_B64=<base64-encoded-license-json>

# Worker tuning (optional)
WORKER_POLL_INTERVAL=2
WORKER_HEARTBEAT_INTERVAL=5
WORKER_STALE_AFTER_SECONDS=120

# Storage paths (optional)
# BASE_DATASETS_DIR=/path/to/datasets
# BASE_TRAINING_DIR=/path/to/training_runs
# BASE_TEMP_DIR=/path/to/temp
# BASE_PRETRAIN_MODELS_DIR=/path/to/pretrain_models

# Dataset import tuning (optional)
# DATASET_IMPORT_ROOTS=/path/to/imports;/path/to/shared-datasets
# DATASET_IMPORT_MAX_WORKERS=8
# ILLEGAL_DATASET_PUBLISH_MAX_WORKERS=4

# MLflow tracking (optional)
# MLFLOW_ENABLE=true
# MLFLOW_TRACKING_URI=file:./mlruns
# MLFLOW_EXPERIMENT_NAME=TrainPlatform
